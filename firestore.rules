rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true when the requesting user has role == 'admin' in userRoles.
    // Uses exists() to avoid errors when the doc is not yet created.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }

    // Bootstrap allow-list — mirrors VITE_FIRST_ADMIN_EMAIL, but enforced
    // server-side where a client can never read or rewrite it. This is the
    // ONLY path through which a brand-new account may create its own profile
    // with role:'admin'; every other self-created profile is forced to
    // role:'viewer' / accountStatus:'Pending Approval' by the create rule below.
    function isDesignatedAdminEmail() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'justice.jackis89@gmail.com',
          'juejack1@gmail.com'
        ];
    }

    // True when an admin pre-assigned `role` to the requester's email via
    // Admin Panel → Invite Users (pendingRoles/{email}) before they signed
    // up. The Invite UI only ever offers non-admin roles and pendingRoles
    // create/update is admin-gated, but `role != 'admin'` is kept here as
    // the final, authoritative guard — this function is the one thing that
    // lets a self-registration land with anything other than role:'viewer',
    // so it must never be able to hand out admin under any circumstance.
    function hasPreAssignedRole(role) {
      return role != 'admin'
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/pendingRoles/$(request.auth.token.email))
        && get(/databases/$(database)/documents/pendingRoles/$(request.auth.token.email)).data.role == role;
    }

    // True when `field` is left exactly as-is by this write, OR is being
    // added for the first time with exactly `safeDefault`. The second branch
    // covers userRoles documents written before role/accountStatus existed —
    // comparing directly against a missing map key throws in rules, and a
    // self-write must still be unable to backfill the field to anything other
    // than the safe default (e.g. can't "discover" their doc has no status
    // and set it to 'Active' themselves).
    function fieldUnchangedOrBackfilled(data, field, safeDefault) {
      return (field in data && request.resource.data[field] == data[field])
          || (!(field in data) && request.resource.data[field] == safeDefault);
    }

    // ── Department-Based Permissions — server-side mirror of
    // src/utils/permissions.js (PERMISSION_LEVELS / pagePermission /
    // canPerform). This is the actual enforcement boundary for the
    // department permission matrix: client-side button hiding in the
    // app is a UX convenience only — every mutating request below is
    // re-checked here against the requester's stored `department` and
    // the live `departmentPermissions/{pageKey}` matrix, so a direct
    // SDK call, hand-crafted request, or browser console cannot bypass
    // what an administrator configured in Department Permissions.

    // Numeric rank for a permission-level string, low → high. Mirrors
    // the PERMISSION_LEVELS ladder so "Edit" satisfies a "Create"
    // requirement, "Full Access" satisfies everything, etc. Unknown
    // strings rank as 'No Access' (0) — fail closed, never open.
    function levelRank(level) {
      return level == 'Full Access' ? 6
           : level == 'Approve'     ? 5
           : level == 'Delete'      ? 4
           : level == 'Edit'        ? 3
           : level == 'Create'      ? 2
           : level == 'View Only'   ? 1
           : 0;
    }

    // The requester's stored department, or '' when signed out, profile-
    // less, or unassigned — which simply matches no department row below.
    function userDept() {
      return request.auth != null
          && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
          && 'department' in get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data
        ? get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.department
        : '';
    }

    // The level `dept` holds for `pageKey`, defaulting to 'View Only'
    // when the matrix doc or the department's entry doesn't exist yet —
    // mirrors DEFAULT_PERMISSION_LEVEL in permissions.js. This default
    // satisfies "view" checks but fails every mutating one, so the
    // system is safe (read-only for everyone but admins) even in the
    // brief window before an administrator first opens Department
    // Permissions and ensureMatrixSeeded() writes the spec's defaults.
    function deptPermissionLevel(pageKey, dept) {
      return exists(/databases/$(database)/documents/departmentPermissions/$(pageKey))
          && 'permissions' in get(/databases/$(database)/documents/departmentPermissions/$(pageKey)).data
          && dept in get(/databases/$(database)/documents/departmentPermissions/$(pageKey)).data.permissions
        ? get(/databases/$(database)/documents/departmentPermissions/$(pageKey)).data.permissions[dept]
        : 'View Only';
    }

    // True when the requester is an administrator — the unrestricted
    // super-user override ("Administrators get unrestricted access to
    // everything") — OR their department's configured level for
    // `pageKey` satisfies `minLevel`. This is the one function every
    // department-gated collection rule below calls; it is the literal
    // server-side equivalent of canPerform() in permissions.js.
    function hasDeptPermission(pageKey, minLevel) {
      return isAdmin() || (
        request.auth != null
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && levelRank(deptPermissionLevel(pageKey, userDept())) >= levelRank(minLevel)
      );
    }

    // ── userRoles ────────────────────────────────────────────────
    // Single source of truth for role + account status. Field-level checks
    // below are the actual enforcement point for "no self-promotion": a user
    // may create and refresh their own profile, but can NEVER write a role or
    // accountStatus value through their own session — only an admin can.
    match /userRoles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // First-time profile creation. This is the actual server-side fix for
      // "new users receiving admin by default": a self-registering account
      // (request.auth.uid == userId) is FORCED into accountStatus:
      // 'Pending Approval' with role:'viewer' — UNLESS an admin pre-assigned
      // a (non-admin) role for that email via Invite Users, in which case
      // the pre-assigned role is honored but the account still lands in
      // Pending Approval and still requires explicit admin approval. The
      // sole exception is the allow-listed bootstrap path for the designated
      // admin email(s), which must request exactly role:'admin' / status:
      // 'Active'. No client-supplied value can produce role:'admin' through
      // any other route. Admins may additionally create a profile for a
      // DIFFERENT uid — this is the Diagnostics → "Approve failed
      // registration" recovery flow, where the admin writes the stuck
      // account's document on its behalf.
      allow create: if request.auth != null && (
        isAdmin()
        || (request.auth.uid == userId
            && request.resource.data.accountStatus == 'Pending Approval'
            && (
              request.resource.data.role == 'viewer'
              || hasPreAssignedRole(request.resource.data.role)
            )
           )
        || (request.auth.uid == userId
            && isDesignatedAdminEmail()
            && request.resource.data.role == 'admin'
            && request.resource.data.accountStatus == 'Active')
      );

      // A user may keep their own profile fresh (lastLogin, name, dept, rank)
      // but role and accountStatus must be unchanged — any attempt to alter
      // either is rejected unless the writer is an admin. fieldUnchangedOr
      // Backfilled() also covers legacy docs predating these fields (the
      // syncLegacyUsers backfill adds accountStatus:'Active' on first touch);
      // comparing straight against a missing key would throw and deny the
      // write outright, breaking lastLogin updates for those accounts.
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId
            && fieldUnchangedOrBackfilled(resource.data, 'role', 'viewer')
            && fieldUnchangedOrBackfilled(resource.data, 'accountStatus', 'Active'));

      allow delete: if isAdmin();
    }

    // ── pendingRoles ─────────────────────────────────────────────
    // Admin-pre-assigned roles keyed by email address.
    // Users can read the doc matching their own email (consumed during sign-in)
    // and delete it once claimed. Only admins may create/update pre-assignments.
    match /pendingRoles/{email} {
      allow read:          if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow create, update: if isAdmin();
      allow delete:        if request.auth != null && (request.auth.token.email == email || isAdmin());
    }

    // ── failedRegistrations ──────────────────────────────────────
    // Fallback collection written when userRoles write is blocked.
    // Any authenticated user may create their own entry.
    // Only admins can read, update, or delete (Admin Panel Diagnostics recovery).
    match /failedRegistrations/{userId} {
      allow create:          if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if isAdmin();
    }

    // ── issuances ────────────────────────────────────────────────
    // All authenticated users can read issuance records (transparency).
    // Writes (record / edit / delete an issuance, the "issue materials,
    // approve transactions" capability) require at least 'Create' on the
    // Inventory page — by default only Stores / Inventory holds that
    // (Full Access); every other department is 'View Only' and is
    // rejected here even if they bypass the UI. Administrators always pass.
    match /issuances/{docId} {
      allow read: if request.auth != null;
      allow write: if hasDeptPermission('inventory', 'Create');
    }

    // ── inventoryItems ───────────────────────────────────────────
    // Per-material metadata (item codes, warehouse locations).
    // Same Inventory-page department gate as issuances — see above.
    match /inventoryItems/{docId} {
      allow read: if request.auth != null;
      allow write: if hasDeptPermission('inventory', 'Create');
    }

    // ── inventoryAdjustments ─────────────────────────────────────
    // Corrections, write-offs, and transfers. Requires Edit-level access
    // (one tier above Create) — adjustments are more sensitive than plain
    // receipts or issuances because they can increase or decrease stock
    // without a corresponding physical transaction.
    match /inventoryAdjustments/{docId} {
      allow read: if request.auth != null;
      allow write: if hasDeptPermission('inventory', 'Edit');
    }

    // ── manualReceipts ───────────────────────────────────────────
    // Goods-received records added manually through the Inventory page.
    // Same Inventory-page department gate as issuances / inventoryItems.
    match /manualReceipts/{docId} {
      allow read: if request.auth != null;
      allow write: if hasDeptPermission('inventory', 'Create');
    }

    // ── droneActivities ──────────────────────────────────────────
    // All authenticated users can read (transparency for other depts).
    // Create / update / delete require at least 'Create' on the Drone &
    // Survey Operations page — by default only Survey & GIS holds that
    // (Full Access: create/update/delete activities, manage progress
    // records); every other department is 'View Only'. Admins always pass.
    match /droneActivities/{activityId} {
      allow read: if request.auth != null;
      allow write: if hasDeptPermission('droneSurveyOps', 'Create');
    }

    // ── droneActivityLogs ─────────────────────────────────────────
    // Immutable audit trail — only append, never edit or delete.
    // Any authenticated user can read. The create gate intentionally
    // mirrors droneActivities' write gate one-for-one: every activity
    // mutation the client performs writes a paired log entry (see
    // writeLog() in droneActivityService.js), so whoever may create/
    // update/delete an activity must also be able to log it, or their
    // (otherwise-valid) activity write fails on the follow-up log write.
    match /droneActivityLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if hasDeptPermission('droneSurveyOps', 'Create');
      allow update, delete: if false;
    }

    // ── departmentPermissions ────────────────────────────────────
    // The live department × page permission matrix that
    // hasDeptPermission() above (and canPerform()/canAccessRoute() on
    // the client) reads to decide every gated action platform-wide.
    // Any authenticated user may read it — each session needs it to
    // compute its own effective permissions and render the right UI.
    // Only administrators may create/update/delete entries; every
    // change is additionally written to permissionAuditLog by the
    // client (see savePagePermissions in departmentPermissionsService.js).
    match /departmentPermissions/{pageKey} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ── permissionAuditLog ───────────────────────────────────────
    // Immutable trail of every permission-matrix change: administrator,
    // department affected, previous level, new level, timestamp — append
    // only, exactly like droneActivityLogs. Admin-only in both directions;
    // this is an administrative record, not a user-facing collection.
    match /permissionAuditLog/{logId} {
      allow read:           if isAdmin();
      allow create:         if isAdmin();
      allow update, delete: if false;
    }

    // ── _diagnostics ─────────────────────────────────────────────
    // Temporary write-test documents created by the Admin Panel Diagnostics tab.
    // Admin-only — this collection previously allowed any authenticated user
    // to read/write/delete arbitrary docs here, which let any signed-in
    // account probe or tamper with another user's diagnostic test records.
    match /_diagnostics/{docId} {
      allow read, write, delete: if isAdmin();
    }
  }
}
